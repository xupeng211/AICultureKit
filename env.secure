# 安全配置模板 - 修复致命安全问题后的推荐配置

# ============================================
# API服务配置 - 安全网络绑定
# ============================================
API_HOST=127.0.0.1  # 只监听本地，生产环境根据需要调整到内网IP
API_PORT=8000
DEBUG=false  # 生产环境必须为false，开发环境可设为true

# ============================================
# CORS安全配置 - 限制允许的域名
# ============================================
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com  # 修复通配符风险

# ============================================
# 应用基础配置
# ============================================
ENVIRONMENT=production  # development/staging/production
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/aiculturekit
REDIS_URL=redis://localhost:6379/0

# ============================================
# 外部API配置 - 请妥善保管密钥
# ============================================
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================
# 文件存储配置
# ============================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO  # DEBUG/INFO/WARNING/ERROR
LOG_FILE=./logs/app.log

# ============================================
# 缓存配置
# ============================================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================
# 安全配置 - JWT令牌
# ============================================
JWT_SECRET=your-jwt-secret-must-be-complex-and-at-least-32-characters
JWT_EXPIRATION=3600

# ============================================
# 监控配置
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# GitHub Token - CI监控工具使用
# ============================================
GITHUB_TOKEN=your-github-token-for-ci-monitoring 